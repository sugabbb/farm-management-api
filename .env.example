APP_NAME="Farm Management API"
APP_ENV=local
APP_TIMEZONE=Asia/Jakarta
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/pondok_berkah
API_KEY=replace-with-a-long-random-value
API_PREVIOUS_KEY=
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=farm-management-api
JWT_AUDIENCE=farm-management-frontend
JWT_TTL_HOURS=8
CORS_ALLOWED_ORIGINS=http://localhost:3000
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_STORAGE_PREFIX=
GOOGLE_APPLICATION_CREDENTIALS=
LOG_LEVEL=INFO

